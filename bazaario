<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bazaario — Everything, Delivered</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700;800&family=Source+Code+Pro:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#0F2036;
    --navy-2:#16304F;
    --mustard:#E8A33D;
    --mustard-dark:#C77F1F;
    --ink:#1B2430;
    --muted:#5B6472;
    --success:#2F855A;
    --danger:#D6455B;
    --line:#E4E7EC;
    --bg:#F2F4F7;
    --card:#FFFFFF;
    --radius:10px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:'Work Sans',Arial,sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,h4{font-family:'Work Sans',Arial,sans-serif;margin:0;}
  .mono{font-family:'Source Code Pro',monospace;}
  a{text-decoration:none;color:inherit;}
  button{font-family:inherit;cursor:pointer;}
  img{display:block;max-width:100%;}
  ::selection{background:var(--mustard);color:var(--navy);}

  /* ---------- Header ---------- */
  header.site{background:var(--navy);color:#fff;position:sticky;top:0;z-index:50;}
  .topbar{
    display:flex;align-items:center;gap:18px;
    padding:14px 24px;max-width:1400px;margin:0 auto;
  }
  .logo{display:flex;align-items:baseline;gap:6px;font-family:'Work Sans',Arial,sans-serif;font-weight:800;font-size:22px;letter-spacing:-0.5px;flex-shrink:0;}
  .logo .dot{color:var(--mustard);}
  .search-wrap{flex:1;display:flex;max-width:680px;background:#fff;border-radius:8px;overflow:hidden;}
  .search-wrap select{border:none;background:#EDEFF2;color:var(--ink);padding:0 10px;font-size:13px;border-right:1px solid var(--line);}
  .search-wrap input{flex:1;border:none;padding:11px 12px;font-size:14px;color:var(--ink);outline:none;}
  .search-wrap button{background:var(--mustard);border:none;padding:0 18px;display:flex;align-items:center;justify-content:center;transition:background .15s;}
  .search-wrap button:hover{background:var(--mustard-dark);}
  .icon-actions{display:flex;align-items:center;gap:20px;margin-left:auto;flex-shrink:0;}
  .icon-btn{display:flex;flex-direction:column;align-items:center;gap:2px;font-size:11px;color:#D8DEE9;background:none;border:none;position:relative;padding:4px;}
  .icon-btn:hover{color:#fff;}
  .icon-btn svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8;}
  .badge-count{
    position:absolute;top:-4px;right:-8px;background:var(--danger);color:#fff;
    font-size:10px;font-weight:700;border-radius:20px;padding:1px 5px;min-width:16px;text-align:center;
    font-family:'Source Code Pro',monospace;
  }
  .catbar{background:var(--navy-2);}
  .catbar-inner{max-width:1400px;margin:0 auto;display:flex;gap:4px;padding:0 20px;overflow-x:auto;}
  .catbar button{
    background:none;border:none;color:#CBD5E1;padding:10px 14px;font-size:13px;white-space:nowrap;
    border-bottom:2px solid transparent;transition:.15s;
  }
  .catbar button:hover, .catbar button.active{color:#fff;border-bottom-color:var(--mustard);}

  /* ---------- Hero ---------- */
  .hero{
    background:linear-gradient(120deg,var(--navy) 0%,#1C3C60 100%);
    color:#fff;padding:46px 24px;position:relative;overflow:hidden;
  }
  .hero-inner{max-width:1400px;margin:0 auto;display:flex;align-items:center;gap:40px;}
  .hero h1{font-size:36px;line-height:1.15;max-width:520px;}
  .hero h1 span{color:var(--mustard);}
  .hero p{color:#B9C4D4;margin-top:12px;max-width:480px;font-size:15px;}
  .hero-cta{margin-top:20px;display:inline-flex;background:var(--mustard);color:var(--navy);font-weight:700;padding:12px 22px;border-radius:8px;border:none;font-size:14px;}
  .hero-cta:hover{background:#fff;}
  .hero-strip{display:flex;gap:10px;position:absolute;right:24px;top:50%;transform:translateY(-50%);opacity:.9;}
  .hero-strip .chip{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);padding:8px 14px;border-radius:30px;font-size:12px;color:#E7ECF3;}
  @media (max-width:900px){.hero-strip{display:none;}}

  /* ---------- Layout ---------- */
  .layout{max-width:1400px;margin:0 auto;padding:26px 24px 60px;display:flex;gap:24px;align-items:flex-start;}
  aside.filters{
    width:230px;flex-shrink:0;background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:18px;
    position:sticky;top:118px;
  }
  aside.filters h4{font-size:13px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:10px;}
  .filter-group{margin-bottom:22px;}
  .filter-group ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:6px;}
  .filter-group li button{
    background:none;border:none;text-align:left;padding:6px 8px;border-radius:6px;font-size:13.5px;color:var(--ink);width:100%;
  }
  .filter-group li button:hover{background:var(--bg);}
  .filter-group li button.active{background:#FFF3E0;color:var(--mustard-dark);font-weight:600;}
  input[type=range]{width:100%;accent-color:var(--mustard-dark);}
  .price-readout{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-top:6px;font-family:'Source Code Pro',monospace;}
  .rating-opts{display:flex;flex-direction:column;gap:6px;}
  .rating-opts button{display:flex;align-items:center;gap:6px;background:none;border:1px solid var(--line);border-radius:6px;padding:6px 8px;font-size:12.5px;}
  .rating-opts button.active{border-color:var(--mustard);background:#FFF8EC;}
  .clear-filters{font-size:12px;color:var(--mustard-dark);background:none;border:none;text-decoration:underline;padding:0;}

  main.catalog{flex:1;min-width:0;}
  .catalog-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:10px;}
  .catalog-head h2{font-size:20px;}
  .result-count{font-size:13px;color:var(--muted);}
  .sort-wrap select{border:1px solid var(--line);border-radius:8px;padding:8px 10px;font-size:13px;background:#fff;color:var(--ink);}

  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:18px;}
  .card{
    background:var(--card);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;
    display:flex;flex-direction:column;transition:box-shadow .18s, transform .18s;cursor:pointer;position:relative;
  }
  .card:hover{box-shadow:0 10px 24px rgba(15,32,54,.12);transform:translateY(-3px);}
  .card-img{position:relative;aspect-ratio:1/1;background:#EEF1F5;overflow:hidden;}
  .card-img img{width:100%;height:100%;object-fit:cover;transition:transform .3s;}
  .card:hover .card-img img{transform:scale(1.05);}
  .wish-btn{
    position:absolute;top:8px;right:8px;background:rgba(255,255,255,.92);border:none;border-radius:50%;
    width:32px;height:32px;display:flex;align-items:center;justify-content:center;z-index:2;
  }
  .wish-btn svg{width:16px;height:16px;stroke:var(--ink);fill:none;stroke-width:1.8;}
  .wish-btn.active svg{fill:var(--danger);stroke:var(--danger);}
  .tag-row{position:absolute;top:8px;left:8px;display:flex;flex-direction:column;gap:5px;z-index:2;}
  .tag{
    font-family:'Source Code Pro',monospace;font-size:10.5px;font-weight:700;color:#fff;
    padding:4px 9px 4px 12px;clip-path:polygon(9px 0,100% 0,100% 100%,9px 100%,0 50%);
  }
  .tag.deal{background:var(--danger);}
  .tag.best{background:var(--navy);}
  .tag.new{background:var(--success);}
  .card-body{padding:12px 13px 14px;display:flex;flex-direction:column;gap:6px;flex:1;}
  .card-cat{font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);}
  .card-title{font-size:13.5px;font-weight:600;line-height:1.35;min-height:36px;color:var(--ink);}
  .stars{display:flex;align-items:center;gap:5px;}
  .stars svg{width:13px;height:13px;}
  .star-fill{fill:var(--mustard-dark);stroke:var(--mustard-dark);}
  .star-empty{fill:none;stroke:#C7CDD6;}
  .rev-count{font-size:11px;color:var(--muted);}
  .price-row{display:flex;align-items:baseline;gap:8px;margin-top:2px;}
  .price-now{font-family:'Source Code Pro',monospace;font-weight:700;font-size:17px;color:var(--ink);}
  .price-was{font-family:'Source Code Pro',monospace;font-size:12px;color:var(--muted);text-decoration:line-through;}
  .price-off{font-size:11.5px;color:var(--success);font-weight:600;}
  .add-btn{
    margin-top:8px;background:var(--mustard);border:none;color:var(--navy);font-weight:700;font-size:12.5px;
    padding:9px 10px;border-radius:7px;transition:background .15s;
  }
  .add-btn:hover{background:var(--mustard-dark);color:#fff;}
  .add-btn.added{background:var(--success);color:#fff;}

  .empty-state{padding:60px 20px;text-align:center;color:var(--muted);}
  .empty-state h3{margin-bottom:6px;color:var(--ink);}

  /* ---------- Footer ---------- */
  footer.site{background:var(--navy);color:#AFBACB;padding:36px 24px 20px;margin-top:40px;font-size:13px;}
  footer.site .foot-inner{max-width:1400px;margin:0 auto;display:flex;justify-content:space-between;flex-wrap:wrap;gap:20px;}
  footer.site h5{color:#fff;font-size:13px;margin-bottom:10px;}
  footer.site .cols{display:flex;gap:60px;flex-wrap:wrap;}
  footer.site ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:6px;}
  .foot-bottom{border-top:1px solid rgba(255,255,255,.1);margin-top:26px;padding-top:16px;text-align:center;color:#7E8CA0;font-size:12px;}

  /* ---------- Overlay / Drawer ---------- */
  .overlay{position:fixed;inset:0;background:rgba(15,20,30,.5);opacity:0;pointer-events:none;transition:opacity .2s;z-index:90;}
  .overlay.show{opacity:1;pointer-events:auto;}

  .drawer{
    position:fixed;top:0;right:0;height:100%;width:400px;max-width:92vw;background:#fff;z-index:100;
    transform:translateX(100%);transition:transform .25s ease;display:flex;flex-direction:column;
  }
  .drawer.show{transform:translateX(0);}
  .drawer-head{display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid var(--line);}
  .drawer-head h3{font-size:17px;}
  .close-btn{background:none;border:none;padding:4px;}
  .close-btn svg{width:20px;height:20px;stroke:var(--ink);fill:none;stroke-width:2;}
  .drawer-body{flex:1;overflow-y:auto;padding:14px 20px;display:flex;flex-direction:column;gap:14px;}
  .cart-item{display:flex;gap:12px;border-bottom:1px solid var(--line);padding-bottom:14px;}
  .cart-item img{width:66px;height:66px;object-fit:cover;border-radius:8px;background:#EEF1F5;}
  .cart-item-info{flex:1;display:flex;flex-direction:column;gap:4px;}
  .cart-item-title{font-size:13px;font-weight:600;line-height:1.3;}
  .cart-item-cat{font-size:11px;color:var(--muted);}
  .qty-row{display:flex;align-items:center;gap:10px;margin-top:2px;}
  .qty-btn{width:24px;height:24px;border-radius:6px;border:1px solid var(--line);background:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:14px;}
  .qty-val{font-family:'Source Code Pro',monospace;font-size:13px;min-width:16px;text-align:center;}
  .remove-link{font-size:11.5px;color:var(--danger);background:none;border:none;text-decoration:underline;margin-left:auto;}
  .cart-item-price{font-family:'Source Code Pro',monospace;font-weight:700;font-size:14px;white-space:nowrap;}
  .drawer-foot{border-top:1px solid var(--line);padding:16px 20px 20px;}
  .subtotal-row{display:flex;justify-content:space-between;font-size:15px;margin-bottom:12px;}
  .subtotal-row .val{font-family:'Source Code Pro',monospace;font-weight:700;}
  .checkout-btn{
    width:100%;background:var(--navy);color:#fff;border:none;padding:13px;border-radius:8px;font-weight:700;font-size:14px;
  }
  .checkout-btn:hover{background:var(--navy-2);}
  .continue-shop{display:block;text-align:center;margin-top:10px;font-size:12.5px;color:var(--muted);text-decoration:underline;background:none;border:none;width:100%;}

  /* ---------- Modal (product) ---------- */
  .modal-wrap{position:fixed;inset:0;z-index:110;display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;pointer-events:none;transition:opacity .2s;}
  .modal-wrap.show{opacity:1;pointer-events:auto;}
  .modal{background:#fff;border-radius:14px;max-width:840px;width:100%;max-height:88vh;overflow-y:auto;position:relative;}
  .modal-close{position:absolute;top:14px;right:14px;background:#F2F4F7;border:none;border-radius:50%;width:32px;height:32px;display:flex;align-items:center;justify-content:center;z-index:2;}
  .modal-close svg{width:16px;height:16px;stroke:var(--ink);fill:none;stroke-width:2;}
  .modal-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;}
  @media (max-width:640px){.modal-grid{grid-template-columns:1fr;}}
  .modal-img{background:#EEF1F5;aspect-ratio:1/1;}
  .modal-img img{width:100%;height:100%;object-fit:cover;}
  .modal-info{padding:28px 30px;display:flex;flex-direction:column;gap:12px;}
  .modal-info .card-cat{font-size:11.5px;}
  .modal-info h2{font-size:22px;line-height:1.3;}
  .modal-price-row{display:flex;align-items:baseline;gap:10px;margin-top:4px;}
  .modal-price-row .price-now{font-size:26px;}
  .modal-desc{font-size:13.5px;color:var(--muted);line-height:1.6;}
  .modal-meta{display:flex;gap:16px;font-size:12.5px;color:var(--muted);border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:10px 0;}
  .modal-meta b{color:var(--ink);}
  .modal-actions{display:flex;gap:10px;margin-top:6px;align-items:center;}
  .modal-qty{display:flex;align-items:center;gap:10px;border:1px solid var(--line);border-radius:8px;padding:6px 10px;}
  .buy-now-btn{flex:1;background:var(--navy);color:#fff;border:none;padding:12px;border-radius:8px;font-weight:700;font-size:13.5px;}
  .add-cart-btn2{flex:1;background:var(--mustard);color:var(--navy);border:none;padding:12px;border-radius:8px;font-weight:700;font-size:13.5px;}

  /* ---------- Checkout ---------- */
  .checkout-modal{max-width:520px;padding:0;}
  .co-body{padding:26px 28px;}
  .co-body h2{font-size:20px;margin-bottom:4px;}
  .co-body p.sub{color:var(--muted);font-size:13px;margin-bottom:18px;}
  .field{margin-bottom:12px;}
  .field label{display:block;font-size:12px;color:var(--muted);margin-bottom:5px;font-weight:600;}
  .field input{width:100%;border:1px solid var(--line);border-radius:8px;padding:10px 12px;font-size:13.5px;font-family:inherit;}
  .field input:focus{outline:2px solid var(--mustard);border-color:transparent;}
  .field-row{display:flex;gap:10px;}
  .field-row .field{flex:1;}
  .co-summary{background:var(--bg);border-radius:8px;padding:12px 14px;margin:16px 0;font-size:13px;}
  .co-summary .row{display:flex;justify-content:space-between;padding:3px 0;}
  .co-summary .row.total{font-weight:700;border-top:1px solid var(--line);margin-top:6px;padding-top:8px;font-family:'Source Code Pro',monospace;}
  .place-order-btn{width:100%;background:var(--success);color:#fff;border:none;padding:13px;border-radius:8px;font-weight:700;font-size:14px;}

  /* ---------- Order confirmation (receipt) ---------- */
  .receipt{
    background:#fff;padding:34px 30px 26px;position:relative;
    background-image:radial-gradient(circle,#EEF1F5 3px,transparent 3.5px);
    background-size:14px 14px;background-position:0 0;background-repeat:repeat-x;background-position-y:0;
  }
  .receipt-check{width:52px;height:52px;border-radius:50%;background:#E7F5EC;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;}
  .receipt-check svg{width:26px;height:26px;stroke:var(--success);fill:none;stroke-width:2.5;}
  .receipt h2{text-align:center;font-size:19px;}
  .receipt p.sub{text-align:center;color:var(--muted);font-size:13px;margin-top:6px;}
  .receipt-box{border:1px dashed var(--line);border-radius:10px;padding:16px;margin-top:20px;font-family:'Source Code Pro',monospace;font-size:12.5px;}
  .receipt-box .r-row{display:flex;justify-content:space-between;padding:4px 0;}
  .barcode{display:flex;gap:2px;align-items:flex-end;height:40px;margin-top:16px;justify-content:center;}
  .barcode span{background:var(--ink);width:2px;}
  .receipt-close{width:100%;background:var(--navy);color:#fff;border:none;padding:12px;border-radius:8px;font-weight:700;margin-top:20px;font-size:13.5px;}

  .toast{
    position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--navy);color:#fff;
    padding:12px 20px;border-radius:8px;font-size:13.5px;z-index:200;opacity:0;pointer-events:none;transition:.25s;display:flex;align-items:center;gap:8px;
  }
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
  .toast svg{width:16px;height:16px;stroke:var(--mustard);fill:none;stroke-width:2.5;}

  @media (max-width:860px){
    aside.filters{display:none;}
    .search-wrap select{display:none;}
  }
  @media (max-width:560px){
    .topbar{flex-wrap:wrap;}
    .search-wrap{order:3;width:100%;max-width:none;}
    .hero h1{font-size:26px;}
  }
</style>
</head>
<body>

<header class="site">
  <div class="topbar">
    <div class="logo">Bazaar<span class="dot">io</span></div>
    <div class="search-wrap">
      <select id="searchCat"><option value="all">All</option></select>
      <input id="searchInput" type="text" placeholder="Search Bazaario products...">
      <button id="searchBtn" aria-label="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" stroke="#0F2036" fill="none" stroke-width="2.2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
    </div>
    <div class="icon-actions">
      <button class="icon-btn" id="wishBtn">
        <svg viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
        <span>Wishlist</span>
        <span class="badge-count" id="wishCount" style="display:none;">0</span>
      </button>
      <button class="icon-btn" id="cartBtn">
        <svg viewBox="0 0 24 24"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
        <span>Cart</span>
        <span class="badge-count" id="cartCount" style="display:none;">0</span>
      </button>
    </div>
  </div>
  <nav class="catbar"><div class="catbar-inner" id="catbarInner"></div></nav>
</header>

<section class="hero">
  <div class="hero-inner">
    <div>
      <h1>Everything you need,<br><span>delivered to your door.</span></h1>
      <p>Browse electronics, fashion, home goods, books and more — all in one place, with deals updated daily.</p>
      <button class="hero-cta" id="shopDealsBtn">Shop today's deals →</button>
    </div>
    <div class="hero-strip">
      <div class="chip">🚚 Free shipping over $35</div>
      <div class="chip">↩ 30-day returns</div>
    </div>
  </div>
</section>

<div class="layout">
  <aside class="filters">
    <div class="filter-group">
      <h4>Category</h4>
      <ul id="filterCatList"></ul>
    </div>
    <div class="filter-group">
      <h4>Max Price</h4>
      <input type="range" id="priceRange" min="0" max="700" value="700" step="10">
      <div class="price-readout"><span>$0</span><span id="priceMaxLabel" class="mono">$700</span></div>
    </div>
    <div class="filter-group">
      <h4>Customer Rating</h4>
      <div class="rating-opts" id="ratingOpts"></div>
    </div>
    <button class="clear-filters" id="clearFiltersBtn">Clear all filters</button>
  </aside>

  <main class="catalog">
    <div class="catalog-head">
      <div>
        <h2 id="catalogTitle">All Products</h2>
        <div class="result-count" id="resultCount"></div>
      </div>
      <div class="sort-wrap">
        <select id="sortSelect">
          <option value="relevance">Sort: Featured</option>
          <option value="priceLow">Price: Low to High</option>
          <option value="priceHigh">Price: High to Low</option>
          <option value="rating">Avg. Customer Rating</option>
          <option value="newest">Newest Arrivals</option>
        </select>
      </div>
    </div>
    <div class="grid" id="productGrid"></div>
    <div class="empty-state" id="emptyState" style="display:none;">
      <h3>No products match your filters</h3>
      <p>Try clearing a filter or searching a different term.</p>
    </div>
  </main>
</div>

<footer class="site">
  <div class="foot-inner">
    <div class="logo" style="color:#fff;">Bazaar<span class="dot">io</span></div>
    <div class="cols">
      <div><h5>Get to Know Us</h5><ul><li>About Bazaario</li><li>Careers</li><li>Press</li></ul></div>
