  {id:'p23',name:'QuestMaster Board Game',cat:'Toys & Games',price:24.99,rating:4.5,reviews:1670,seed:'game-p23',new:true,desc:'A cooperative strategy board game for 2-5 players, with roughly 45 minutes per session.'},
  {id:'p24',name:'PureGlow Vitamin C Serum',cat:'Beauty',price:16.99,was:24.99,rating:4.3,reviews:2990,seed:'serum-p24',best:true,deal:true,desc:'A lightweight brightening serum with vitamin C and hyaluronic acid for a more even, radiant look.'},
];
const CATEGORIES = [...new Set(PRODUCTS.map(p=>p.cat))];

/* ================= STATE ================= */
let state = {
  category:'all', search:'', sort:'relevance', priceMax:700, minRating:0,
  cart:{}, wishlist:new Set(),
};

/* ================= UTIL ================= */
const CATEGORY_STYLE = {
  'Electronics':{a:'#2B4C7E',b:'#132A4A',icon:'<rect x="28" y="28" width="84" height="84" rx="10"/><line x1="28" y1="50" x2="8" y2="50"/><line x1="28" y1="90" x2="8" y2="90"/><line x1="112" y1="50" x2="132" y2="50"/><line x1="112" y1="90" x2="132" y2="90"/><line x1="50" y1="28" x2="50" y2="8"/><line x1="90" y1="28" x2="90" y2="8"/><line x1="50" y1="112" x2="50" y2="132"/><line x1="90" y1="112" x2="90" y2="132"/>'},
  'Fashion':{a:'#C2447A',b:'#7A2650',icon:'<path d="M62 30a8 8 0 1 1 16 0"/><path d="M70 30 L20 100 H120 Z"/><line x1="12" y1="112" x2="128" y2="112"/>'},
  'Home & Kitchen':{a:'#B5762C',b:'#6E4315',icon:'<path d="M20 65 L70 20 L120 65"/><path d="M32 58 V120 H108 V58"/><rect x="58" y="80" width="24" height="40"/>'},
  'Books':{a:'#3C6E47',b:'#1E3F26',icon:'<path d="M20 25 H62a10 10 0 0 1 10 10 V115a10 10 0 0 0-10-10H20Z"/><path d="M120 25 H78a10 10 0 0 0-10 10 V115a10 10 0 0 1 10-10h42Z"/>'},
  'Toys & Games':{a:'#6A4FB6',b:'#3A2A6E',icon:'<rect x="18" y="18" width="44" height="44" rx="6"/><rect x="78" y="18" width="44" height="44" rx="6"/><rect x="18" y="78" width="44" height="44" rx="6"/><rect x="78" y="78" width="44" height="44" rx="6"/>'},
  'Beauty':{a:'#D6455B',b:'#7E1F30',icon:'<path d="M70 15C70 15 30 65 30 92a40 40 0 0 0 80 0C110 65 70 15 70 15Z"/>'},
};
function imgUrl(p){
  const s = CATEGORY_STYLE[p.cat] || {a:'#37415A',b:'#1B2233',icon:''};
  const initial = (p.name||'?').charAt(0).toUpperCase();
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 600">
    <defs><linearGradient id="g${p.id}" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="${s.a}"/><stop offset="100%" stop-color="${s.b}"/>
    </linearGradient></defs>
    <rect width="600" height="600" fill="url(#g${p.id})"/>
    <text x="300" y="400" font-family="Work Sans, Arial, sans-serif" font-size="300" font-weight="800" fill="#ffffff" fill-opacity="0.10" text-anchor="middle">${initial}</text>
    <g transform="translate(230,150)" fill="none" stroke="#ffffff" stroke-opacity="0.92" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">${s.icon}</g>
  </svg>`;
  return `data:image/svg+xml,${encodeURIComponent(svg)}`;
}
const fmt = (n)=>`$${n.toFixed(2)}`;

function starsSVG(rating){
  let out='';
  for(let i=1;i<=5;i++){
    const filled = rating >= i - 0.25;
    out += `<svg viewBox="0 0 24 24" class="${filled?'star-fill':'star-empty'}" stroke-width="1.5"><polygon points="12 2 15.09 8.63 22 9.24 17 14.14 18.18 21 12 17.77 5.82 21 7 14.14 2 9.24 8.91 8.63"/></svg>`;
  }
  return out;
}

function showToast(msg){
  const t = document.getElementById('toast');
  document.getElementById('toastMsg').textContent = msg;
  t.classList.add('show');
  clearTimeout(window._toastTimer);
  window._toastTimer = setTimeout(()=>t.classList.remove('show'), 1800);
}

/* ================= FILTER / SORT ================= */
function getFiltered(){
  let list = PRODUCTS.filter(p=>{
    if(state.category!=='all' && p.cat!==state.category) return false;
    if(p.price > state.priceMax) return false;
    if(state.minRating && p.rating < state.minRating) return false;
    if(state.search){
      const q = state.search.toLowerCase();
      if(!p.name.toLowerCase().includes(q) && !p.cat.toLowerCase().includes(q)) return false;
    }
    return true;
  });
  switch(state.sort){
    case 'priceLow': list = list.slice().sort((a,b)=>a.price-b.price); break;
    case 'priceHigh': list = list.slice().sort((a,b)=>b.price-a.price); break;
    case 'rating': list = list.slice().sort((a,b)=>b.rating-a.rating); break;
    case 'newest': list = list.slice().sort((a,b)=>(b.new===true)-(a.new===true)); break;
  }
  return list;
}

/* ================= RENDER: FILTER SIDEBAR / CATBAR ================= */
function renderStaticFilters(){
  const catbar = document.getElementById('catbarInner');
  catbar.innerHTML = `<button data-cat="all" class="active">All Categories</button>` +
    CATEGORIES.map(c=>`<button data-cat="${c}">${c}</button>`).join('');
  catbar.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>{
    state.category = b.dataset.cat;
    syncCategoryUI(); renderGrid();
  }));

  const filterCatList = document.getElementById('filterCatList');
  filterCatList.innerHTML = `<li><button data-cat="all" class="active">All Categories</button></li>` +
    CATEGORIES.map(c=>`<li><button data-cat="${c}">${c}</button></li>`).join('');
  filterCatList.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>{
    state.category = b.dataset.cat;
    syncCategoryUI(); renderGrid();
  }));

  const searchCat = document.getElementById('searchCat');
  CATEGORIES.forEach(c=>{
    const o=document.createElement('option'); o.value=c; o.textContent=c; searchCat.appendChild(o);
  });

  const ratingOpts = document.getElementById('ratingOpts');
  ratingOpts.innerHTML = [0,4,3].map(r=>`<button data-r="${r}" class="${r===0?'active':''}">${r===0?'Any rating':'★ '+r+' & up'}</button>`).join('');
  ratingOpts.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>{
    state.minRating = Number(b.dataset.r);
    ratingOpts.querySelectorAll('button').forEach(x=>x.classList.toggle('active', x===b));
    renderGrid();
  }));

  document.getElementById('priceRange').addEventListener('input', e=>{
    state.priceMax = Number(e.target.value);
    document.getElementById('priceMaxLabel').textContent = fmt(state.priceMax);
    renderGrid();
  });

  document.getElementById('clearFiltersBtn').addEventListener('click', ()=>{
    state.category='all'; state.priceMax=700; state.minRating=0; state.search='';
    document.getElementById('priceRange').value=700;
    document.getElementById('priceMaxLabel').textContent = '$700';
    document.getElementById('searchInput').value='';
    ratingOpts.querySelectorAll('button').forEach((x,i)=>x.classList.toggle('active', i===0));
    syncCategoryUI(); renderGrid();
  });
}

function syncCategoryUI(){
  document.querySelectorAll('#catbarInner button').forEach(b=>b.classList.toggle('active', b.dataset.cat===state.category));
  document.querySelectorAll('#filterCatList button').forEach(b=>b.classList.toggle('active', b.dataset.cat===state.category));
  document.getElementById('catalogTitle').textContent = state.category==='all' ? 'All Products' : state.category;
}

/* ================= RENDER: GRID ================= */
function renderGrid(){
  const list = getFiltered();
  const grid = document.getElementById('productGrid');
  const empty = document.getElementById('emptyState');
  document.getElementById('resultCount').textContent = `${list.length} result${list.length!==1?'s':''}`;

  if(list.length===0){
    grid.innerHTML=''; empty.style.display='block';
    return;
  }
  empty.style.display='none';

  grid.innerHTML = list.map(p=>{
    const off = p.was ? Math.round((1-p.price/p.was)*100) : 0;
    const inWish = state.wishlist.has(p.id);
    return `
    <div class="card" data-id="${p.id}">
      <div class="card-img">
        <div class="tag-row">
          ${p.deal?'<span class="tag deal">DEAL -'+off+'%</span>':''}
          ${p.best?'<span class="tag best">BEST SELLER</span>':''}
          ${p.new?'<span class="tag new">NEW</span>':''}
        </div>
        <button class="wish-btn ${inWish?'active':''}" data-wish="${p.id}" aria-label="Toggle wishlist">
          <svg viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
        </button>
        <img src="${imgUrl(p)}" alt="${p.name}" loading="lazy">
      </div>
      <div class="card-body">
        <div class="card-cat">${p.cat}</div>
        <div class="card-title">${p.name}</div>
        <div class="stars">${starsSVG(p.rating)}<span class="rev-count">(${p.reviews.toLocaleString()})</span></div>
        <div class="price-row">
          <span class="price-now">${fmt(p.price)}</span>
          ${p.was?`<span class="price-was">${fmt(p.was)}</span>`:''}
        </div>
        ${p.was?`<div class="price-off">You save ${fmt(p.was-p.price)} (${off}%)</div>`:''}
        <button class="add-btn" data-add="${p.id}">Add to Cart</button>
      </div>
    </div>`;
  }).join('');

  grid.querySelectorAll('.card').forEach(card=>{
    card.addEventListener('click', (e)=>{
      if(e.target.closest('[data-add]') || e.target.closest('[data-wish]')) return;
      openProductModal(card.dataset.id);
    });
  });
  grid.querySelectorAll('[data-add]').forEach(btn=>{
    btn.addEventListener('click', (e)=>{
      e.stopPropagation();
      addToCart(btn.dataset.add, 1);
      btn.textContent = 'Added ✓'; btn.classList.add('added');
      setTimeout(()=>{btn.textContent='Add to Cart'; btn.classList.remove('added');}, 1200);
    });
  });
  grid.querySelectorAll('[data-wish]').forEach(btn=>{
    btn.addEventListener('click', (e)=>{
      e.stopPropagation();
      toggleWishlist(btn.dataset.wish);
      btn.classList.toggle('active');
    });
  });
}

/* ================= WISHLIST ================= */
function toggleWishlist(id){
  if(state.wishlist.has(id)){ state.wishlist.delete(id); }
  else { state.wishlist.add(id); showToast('Saved to wishlist'); }
  const c = state.wishlist.size;
  const badge = document.getElementById('wishCount');
  badge.style.display = c>0?'block':'none';
  badge.textContent = c;
}

/* ================= CART ================= */
function addToCart(id, qty){
  state.cart[id] = (state.cart[id]||0) + qty;
  renderCartCount();
  renderCartDrawer();
  showToast('Added to cart');
}
function setQty(id, qty){
  if(qty<=0){ delete state.cart[id]; }
  else { state.cart[id]=qty; }
  renderCartCount(); renderCartDrawer();
}
function removeFromCart(id){ delete state.cart[id]; renderCartCount(); renderCartDrawer(); }

function cartEntries(){
  return Object.entries(state.cart).map(([id,qty])=>({product:PRODUCTS.find(p=>p.id===id), qty})).filter(e=>e.product);
}
function cartSubtotal(){
  return cartEntries().reduce((s,e)=>s+e.product.price*e.qty,0);
}
function cartCount(){
  return Object.values(state.cart).reduce((s,q)=>s+q,0);
}

function renderCartCount(){
  const c = cartCount();
  const badge = document.getElementById('cartCount');
  badge.style.display = c>0?'block':'none';
  badge.textContent = c;
}

function renderCartDrawer(){
  const body = document.getElementById('cartBody');
  const foot = document.getElementById('cartFoot');
  const entries = cartEntries();

  if(entries.length===0){
    body.innerHTML = `<div class="empty-state"><h3>Your cart is empty</h3><p>Browse products and add something you like.</p></div>`;
    foot.innerHTML = `<button class="continue-shop" id="continueShop2">Continue shopping</button>`;
    document.getElementById('continueShop2').addEventListener('click', closeCart);
    return;
  }

  body.innerHTML = entries.map(e=>`
    <div class="cart-item" data-id="${e.product.id}">
      <img src="${imgUrl(e.product)}" alt="${e.product.name}">
      <div class="cart-item-info">
        <div class="cart-item-title">${e.product.name}</div>
        <div class="cart-item-cat">${e.product.cat}</div>
        <div class="qty-row">
          <button class="qty-btn" data-dec>−</button>
          <span class="qty-val">${e.qty}</span>
          <button class="qty-btn" data-inc>+</button>
          <button class="remove-link" data-remove>Remove</button>
        </div>
      </div>
      <div class="cart-item-price">${fmt(e.product.price*e.qty)}</div>
    </div>
  `).join('');

  body.querySelectorAll('.cart-item').forEach(row=>{
    const id = row.dataset.id;
    row.querySelector('[data-inc]').addEventListener('click', ()=>setQty(id,(state.cart[id]||0)+1));
    row.querySelector('[data-dec]').addEventListener('click', ()=>setQty(id,(state.cart[id]||0)-1));
    row.querySelector('[data-remove]').addEventListener('click', ()=>removeFromCart(id));
  });

  const subtotal = cartSubtotal();
  foot.innerHTML = `
    <div class="subtotal-row"><span>Subtotal (${cartCount()} item${cartCount()!==1?'s':''})</span><span class="val">${fmt(subtotal)}</span></div>
    <button class="checkout-btn" id="goCheckout">Proceed to Checkout</button>
    <button class="continue-shop" id="continueShop">Continue shopping</button>
  `;
  document.getElementById('goCheckout').addEventListener('click', openCheckout);
  document.getElementById('continueShop').addEventListener('click', closeCart);
}

/* ================= DRAWER OPEN/CLOSE ================= */
function openCart(){ document.getElementById('cartDrawer').classList.add('show'); document.getElementById('overlay').classList.add('show'); }
function closeCart(){ document.getElementById('cartDrawer').classList.remove('show'); document.getElementById('overlay').classList.remove('show'); }

/* ================= PRODUCT MODAL ================= */
function openProductModal(id){
  const p = PRODUCTS.find(x=>x.id===id);
  if(!p) return;
  const off = p.was ? Math.round((1-p.price/p.was)*100) : 0;
  let qty = 1;
  const modal = document.getElementById('productModal');
  modal.innerHTML = `
    <button class="modal-close" id="closeProductModal"><svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    <div class="modal-grid">
      <div class="modal-img"><img src="${imgUrl(p)}" alt="${p.name}"></div>
      <div class="modal-info">
        <div class="card-cat">${p.cat}</div>
        <h2>${p.name}</h2>
        <div class="stars">${starsSVG(p.rating)}<span class="rev-count">${p.rating} · ${p.reviews.toLocaleString()} ratings</span></div>
        <div class="modal-price-row">
          <span class="price-now">${fmt(p.price)}</span>
          ${p.was?`<span class="price-was">${fmt(p.was)}</span><span class="price-off">Save ${off}%</span>`:''}
        </div>
        <p class="modal-desc">${p.desc}</p>
        <div class="modal-meta">
          <div>🚚 <b>Free delivery</b><br>in 2-4 business days</div>
          <div>↩ <b>30-day</b><br>easy returns</div>
        </div>
        <div class="modal-actions">
          <div class="modal-qty">
            <button class="qty-btn" id="mQtyDec">−</button>
            <span class="qty-val" id="mQtyVal">1</span>
            <button class="qty-btn" id="mQtyInc">+</button>
          </div>
          <button class="add-cart-btn2" id="mAddCart">Add to Cart</button>
          <button class="buy-now-btn" id="mBuyNow">Buy Now</button>
        </div>
      </div>
    </div>
  `;
  document.getElementById('mQtyInc').addEventListener('click', ()=>{ qty++; document.getElementById('mQtyVal').textContent=qty; });
  document.getElementById('mQtyDec').addEventListener('click', ()=>{ if(qty>1){qty--; document.getElementById('mQtyVal').textContent=qty;} });
  document.getElementById('mAddCart').addEventListener('click', ()=>{ addToCart(p.id, qty); closeProductModal(); });
  document.getElementById('mBuyNow').addEventListener('click', ()=>{ addToCart(p.id, qty); closeProductModal(); openCheckout(); });
  document.getElementById('closeProductModal').addEventListener('click', closeProductModal);

  document.getElementById('productModalWrap').classList.add('show');
}
function closeProductModal(){ document.getElementById('productModalWrap').classList.remove('show'); }

/* ================= CHECKOUT ================= */
function openCheckout(){
  if(cartCount()===0){ showToast('Your cart is empty'); return; }
  closeCart();
  const subtotal = cartSubtotal();
  const shipping = subtotal >= 35 ? 0 : 5.99;
  const tax = subtotal * 0.08;
  const total = subtotal + shipping + tax;
  const modal = document.getElementById('checkoutModal');
  modal.innerHTML = `
    <button class="modal-close" id="closeCheckout"><svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    <div class="co-body">
      <h2>Checkout</h2>
      <p class="sub">Enter your details to place this demo order.</p>
      <div class="field"><label>Full name</label><input id="coName" type="text" placeholder="Jordan Smith"></div>
      <div class="field"><label>Address</label><input id="coAddr" type="text" placeholder="123 Market Street"></div>
      <div class="field-row">
        <div class="field"><label>City</label><input id="coCity" type="text" placeholder="Springfield"></div>
        <div class="field"><label>ZIP code</label><input id="coZip" type="text" placeholder="94105"></div>
      </div>
      <div class="field"><label>Card number</label><input id="coCard" type="text" placeholder="4242 4242 4242 4242" maxlength="19"></div>
      <div class="field-row">
        <div class="field"><label>Expiry</label><input id="coExp" type="text" placeholder="MM/YY"></div>
        <div class="field"><label>CVV</label><input id="coCvv" type="text" placeholder="123" maxlength="4"></div>
      </div>
      <div class="co-summary">
        <div class="row"><span>Subtotal</span><span class="mono">${fmt(subtotal)}</span></div>
        <div class="row"><span>Shipping</span><span class="mono">${shipping===0?'FREE':fmt(shipping)}</span></div>
        <div class="row"><span>Estimated tax</span><span class="mono">${fmt(tax)}</span></div>
        <div class="row total"><span>Total</span><span>${fmt(total)}</span></div>
      </div>
      <button class="place-order-btn" id="placeOrderBtn">Place Order</button>
    </div>
  `;
  document.getElementById('closeCheckout').addEventListener('click', closeCheckout);
  document.getElementById('placeOrderBtn').addEventListener('click', ()=>placeOrder(total));
  document.getElementById('checkoutModalWrap').classList.add('show');
}
function closeCheckout(){ document.getElementById('checkoutModalWrap').classList.remove('show'); }

function placeOrder(total){
  const orderNum = 'BZ-' + Math.floor(100000 + Math.random()*899999);
  const items = cartCount();
  const eta = new Date(Date.now() + 4*86400000);
  const etaStr = eta.toLocaleDateString(undefined,{weekday:'short',month:'short',day:'numeric'});
  const barWidths = Array.from({length:38},()=> (Math.random()*3+1).toFixed(1));

  const modal = document.getElementById('checkoutModal');
  modal.innerHTML = `
    <button class="modal-close" id="closeReceipt"><svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    <div class="receipt">
      <div class="receipt-check"><svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg></div>
      <h2>Order placed!</h2>
      <p class="sub">Thanks — a confirmation has been "sent" to your inbox (demo only).</p>
      <div class="receipt-box">
        <div class="r-row"><span>ORDER #</span><span>${orderNum}</span></div>
        <div class="r-row"><span>ITEMS</span><span>${items}</span></div>
        <div class="r-row"><span>TOTAL</span><span>${fmt(total)}</span></div>
        <div class="r-row"><span>ARRIVES BY</span><span>${etaStr}</span></div>
      </div>
      <div class="barcode">${barWidths.map(w=>`<span style="width:${w}px;height:${Math.random()>0.3?'40px':'26px'};"></span>`).join('')}</div>
      <button class="receipt-close" id="closeReceipt2">Continue Shopping</button>
    </div>
  `;
  state.cart = {};
  renderCartCount();
  renderCartDrawer();
  document.getElementById('closeReceipt').addEventListener('click', closeCheckout);
  document.getElementById('closeReceipt2').addEventListener('click', closeCheckout);
}

/* ================= SEARCH / SORT WIRES ================= */
function runSearch(){
  const term = document.getElementById('searchInput').value.trim();
  const cat = document.getElementById('searchCat').value;
  state.search = term;
  state.category = cat;
  syncCategoryUI();
  renderGrid();
}
document.getElementById('searchBtn').addEventListener('click', runSearch);
document.getElementById('searchInput').addEventListener('keydown', e=>{ if(e.key==='Enter') runSearch(); });
document.getElementById('sortSelect').addEventListener('change', e=>{ state.sort=e.target.value; renderGrid(); });
document.getElementById('shopDealsBtn').addEventListener('click', ()=>{
  state.category='all'; state.search=''; state.sort='relevance';
  document.getElementById('searchInput').value='';
  syncCategoryUI(); renderGrid();
  window.scrollTo({top:document.querySelector('.layout').offsetTop-100, behavior:'smooth'});
});

/* ================= GLOBAL OPEN/CLOSE WIRES ================= */
document.getElementById('cartBtn').addEventListener('click', openCart);
document.getElementById('closeCart').addEventListener('click', closeCart);
document.getElementById('overlay').addEventListener('click', ()=>{ closeCart(); });
document.getElementById('productModalWrap').addEventListener('click', e=>{ if(e.target.id==='productModalWrap') closeProductModal(); });
document.getElementById('checkoutModalWrap').addEventListener('click', e=>{ if(e.target.id==='checkoutModalWrap') closeCheckout(); });
document.getElementById('wishBtn').addEventListener('click', ()=>{
  state.category='all'; state.search=''; 
  document.getElementById('searchInput').value='';
  syncCategoryUI();
  const grid = document.getElementById('productGrid');
  const wishlisted = PRODUCTS.filter(p=>state.wishlist.has(p.id));
  if(wishlisted.length===0){ showToast('Your wishlist is empty'); }
  document.getElementById('catalogTitle').textContent = 'Your Wishlist';
  document.getElementById('resultCount').textContent = `${wishlisted.length} result${wishlisted.length!==1?'s':''}`;
  document.getElementById('emptyState').style.display = wishlisted.length===0?'block':'none';
  grid.innerHTML = wishlisted.map(p=>{
    const off = p.was ? Math.round((1-p.price/p.was)*100) : 0;
    return `
    <div class="card" data-id="${p.id}">
      <div class="card-img">
        <div class="tag-row">${p.deal?'<span class="tag deal">DEAL -'+off+'%</span>':''}</div>
        <button class="wish-btn active" data-wish="${p.id}"><svg viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg></button>
        <img src="${imgUrl(p)}" alt="${p.name}">
      </div>
      <div class="card-body">
        <div class="card-cat">${p.cat}</div>
        <div class="card-title">${p.name}</div>
        <div class="price-row"><span class="price-now">${fmt(p.price)}</span></div>
        <button class="add-btn" data-add="${p.id}">Add to Cart</button>
      </div>
    </div>`;
  }).join('');
  grid.querySelectorAll('.card').forEach(card=>{
    card.addEventListener('click', (e)=>{
      if(e.target.closest('[data-add]') || e.target.closest('[data-wish]')) return;
      openProductModal(card.dataset.id);
    });
  });
  grid.querySelectorAll('[data-add]').forEach(btn=>btn.addEventListener('click', e=>{ e.stopPropagation(); addToCart(btn.dataset.add,1); }));
  grid.querySelectorAll('[data-wish]').forEach(btn=>btn.addEventListener('click', e=>{
    e.stopPropagation(); toggleWishlist(btn.dataset.wish); document.getElementById('wishBtn').click();
  }));
});

/* ================= INIT ================= */
renderStaticFilters();
renderGrid();
renderCartCount();
renderCartDrawer();
</script>
</body>
</html>
